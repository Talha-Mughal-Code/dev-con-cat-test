<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Get a free quote — Super Pixel live demo</title>

    <!--
      THE SUPER PIXEL SNIPPET.
      Exactly what a buyer pastes into their <head>. Both attributes are
      generated by the app: the pixel id belongs to a real account and the
      endpoint points at this deployment's ingestion API. Nothing on this page
      is simulated - every row in the panel is a real vendor response, run
      through the real consensus engine, streamed back over SSE as each
      background job completes.
    -->
    <script async src="/super-pixel.js"
            data-pixel-id="<%= @pixel.public_id %>"
            data-endpoint="<%= @endpoint %>"></script>

    <%= stylesheet_link_tag "application" %>
    <style>
      .demo { max-width: 1100px; margin: 0 auto; padding: 28px 20px 64px;
              display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
      .demo header { grid-column: 1 / -1; }
      @media (max-width: 860px) { .demo { grid-template-columns: 1fr; } }
      .feed { margin-top: 14px; display: flex; flex-direction: column; gap: 7px;
              max-height: 520px; overflow-y: auto; }
      .feed .layer-row { animation: pop .18s ease; }
      @keyframes pop { from { opacity: 0; transform: translateY(4px); } }
      .panel-head { display: flex; justify-content: space-between; align-items: baseline; }
      .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%;
             background: var(--skip); margin-right: 8px; }
      .final { margin-top: 14px; display: none; }
      .banner { grid-column: 1 / -1; }
    </style>
  </head>
  <body>
    <div class="demo">
      <header>
        <h1>Get your free quote ☀️</h1>
        <p class="muted">
          A demo funnel for <strong><%= @account.company_name %></strong>. The
          <code>super-pixel.js</code> tag in the head is watching this form.
          Fill it in and submit to see every detection layer report live.
        </p>
      </header>

      <div class="card banner tight">
        <h3>Things worth trying</h3>
        <p class="small muted" style="margin:0">
          The mock vendors recognise a contact the way a real vendor would - by
          phone and email, not by our internal lead id. So:
        </p>
        <ul class="small muted" style="margin:8px 0 0; padding-left:20px">
          <li>Submit the pre-filled form as-is for an <strong>ACCEPT</strong> - this
              person is deliberately not one of the twelve seeded leads, so they
              are nobody's duplicate on a freshly seeded database.</li>
          <li>Submit in under 1.5 seconds, or leave the consent box unticked, and the pixel's own first-party layer objects.</li>
          <li>Use <code>anything@mail-tempz.example</code> for a disposable-domain <strong>REJECT</strong>.</li>
          <li>Use <code>+1 818 555 0199</code> - Robert Vance's number - to be caught as a confirmed TCPA litigator.</li>
          <li>Use <code>+1 602 555 0120</code> to hit a Do-Not-Call listing.</li>
          <li>Submit the same person twice: the first is accepted and written into
              the buyer's CRM, so the second is caught as an exact duplicate of a
              record this account now owns.</li>
        </ul>
      </div>

      <!-- The buyer's lead form. data-pixel-form auto-attaches the pixel. -->
      <form class="card" data-pixel-form data-pixel-demo>
        <label for="first_name">First name</label>
        <input id="first_name" name="first_name" autocomplete="given-name" value="Grace" />

        <label for="last_name">Last name</label>
        <input id="last_name" name="last_name" autocomplete="family-name" value="Hopper" />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" value="grace.hopper@gmail.com" />

        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" value="+1 206 555 4471" />

        <label class="check" for="consent">
          <input type="checkbox" id="consent" name="consent" checked />
          <small class="muted">
            By checking this box I agree to be contacted by phone/SMS at the
            number provided, including by automated means. (This is the TCPA
            consent language a TrustedForm certificate must capture.)
          </small>
        </label>

        <button type="submit" class="btn wide" style="margin-top:18px">Get my quote</button>
      </form>

      <!-- The real-time activity panel -->
      <div class="card">
        <div class="panel-head">
          <h2><span class="dot" id="dot"></span>Super Pixel — live activity</h2>
          <span class="small muted" id="live">idle</span>
        </div>

        <div class="feed" id="feed">
          <div class="empty" id="empty">
            Waiting for pixel events… interact with the form to see field
            capture, then submit to run the detection layers.
          </div>
        </div>

        <div class="final" id="final"></div>

        <p class="small muted" id="stack" style="margin-top:12px">
          This account subscribes to
          <%= @layers.count { |layer| layer[:enabled] } %>
          of <%= @layers.size %> layers.
          <% unless @layers.all? { |layer| layer[:enabled] } %>
            Not enabled:
            <%= @layers.reject { |layer| layer[:enabled] }.map { |layer| layer[:name] }.to_sentence %>.
            Those are not passes - they are checks nobody paid for.
          <% end %>
        </p>
      </div>
    </div>

    <script>
      // The HOST PAGE consuming the pixel's event bus. Every event arriving here
      // originated in the Rails app: real vendor responses through the real
      // consensus engine, streamed over SSE as each background job finished.
      (function () {
        var feed = document.getElementById("feed");
        var empty = document.getElementById("empty");
        var live = document.getElementById("live");
        var dot = document.getElementById("dot");
        var finalEl = document.getElementById("final");

        function badgeClass(verdict) {
          switch (verdict) {
            case "pass": return "b-pass";
            case "warn": return "b-warn";
            case "fail": return "b-fail";
            case "skip":
            case "skipped":
            case "not_enabled": return "b-skip";
            case "unavailable": return "b-unavailable";
            default: return "b-info";
          }
        }

        function addRow(name, verdict, detail, meta) {
          if (empty) { empty.remove(); empty = null; }
          var row = document.createElement("div");
          var silent = verdict === "not_enabled" || verdict === "skip" || verdict === "skipped";
          row.className = "layer-row" + (silent ? " silent" : "");
          row.innerHTML =
            '<span class="lname"></span>' +
            '<span class="ldetail"></span>' +
            '<span class="lcost"></span>' +
            '<span class="badge ' + badgeClass(verdict) + '"></span>';
          // textContent throughout: layer detail includes vendor-supplied
          // strings, and this page must not render them as markup.
          row.children[0].textContent = name;
          row.children[1].textContent = detail || "";
          row.children[2].textContent = meta || "";
          row.children[3].textContent = (verdict || "info").replace(/_/g, " ");
          feed.appendChild(row);
          feed.scrollTop = feed.scrollHeight;
        }

        function meta(event) {
          var parts = [];
          if (event.credits_charged) parts.push(event.credits_charged + " cr");
          if (event.latency_ms) parts.push(event.latency_ms + " ms");
          if (event.risk_contribution) parts.push("+" + event.risk_contribution);
          return parts.join(" · ");
        }

        // Subscribe through the ready queue rather than testing for
        // window.SuperPixel. The tag is async, so that test is only true when
        // this inline script happens to lose the race - and when it does not,
        // the panel silently renders nothing. The queue is order-independent.
        (window.SuperPixelQueue = window.SuperPixelQueue || []).push(function (pixel) {
        pixel.onActivity(function (event) {
          switch (event.type) {
            case "session_started":
              live.textContent = "session " + event.session.session_id.slice(0, 12) + "…";
              dot.style.background = "var(--accent)";
              break;

            case "field":
              live.innerHTML = "capturing: <strong>" + event.interaction.name + "</strong> (" +
                event.interaction.action + ")";
              dot.style.background = "var(--warn)";
              break;

            case "submitted":
              addRow("Submitted", "info", "Lead sent to the verification pipeline…");
              live.innerHTML = "<strong>verifying…</strong>";
              break;

            case "accepted":
              addRow("Ingested", "info", "Lead " + event.lead_id + " accepted; streaming results");
              break;

            case "layer_result":
              addRow(event.name || event.layer, event.verdict, event.detail, meta(event));
              break;

            case "info":
              addRow(event.layer === "consensus" ? "Engine" : (event.name || "Engine"),
                     "info", event.detail || event.headline);
              break;

            case "final_verdict":
              finalEl.style.display = "block";
              var verdict = (event.verdict || "").toLowerCase();
              finalEl.className = "final verdict-hero " +
                (verdict === "accept" ? "accept" : verdict === "review" ? "review" :
                 verdict === "reject" ? "reject" : "none");
              var score = event.score != null ? Math.round(event.score * 100) + "% confidence" : "";
              finalEl.innerHTML = "";
              finalEl.appendChild(document.createTextNode(event.verdict + "  ·  " + score));
              var sub = document.createElement("span");
              sub.className = "sub";
              sub.textContent = (event.reasons || []).slice(0, 3).join(" · ");
              finalEl.appendChild(sub);
              live.textContent = "done";
              dot.style.background = verdict === "accept" ? "var(--pass)" :
                verdict === "reject" ? "var(--fail)" : "var(--warn)";
              break;

            case "error":
              addRow("Pixel", "fail", event.message);
              live.textContent = "error";
              dot.style.background = "var(--fail)";
              break;
          }
        });
        });
      })();
    </script>
  </body>
</html>
