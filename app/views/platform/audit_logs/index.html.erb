<% content_for :title, "Access log" %>
<div class="page-head">
  <div>
    <h1>Platform access log</h1>
    <p class="muted small">
      Every cross-account read by a platform operator. Deliberately visible
      rather than write-only - an audit trail nobody can see is a compliance
      decoration, and knowing the reads are recorded is most of the deterrent.
    </p>
  </div>
</div>

<div class="card">
  <table>
    <thead><tr><th>When</th><th>Operator</th><th>Action</th><th>Account read</th><th>Path</th><th>IP</th></tr></thead>
    <tbody>
      <% @logs.each do |log| %>
        <tr>
          <td class="small nowrap"><%= time_short log.occurred_at %></td>
          <td class="small"><%= log.user.name %></td>
          <td class="small"><%= log.action %></td>
          <td class="small"><%= log.account&.public_id || "-" %></td>
          <td class="small muted"><%= log.path %></td>
          <td class="small muted"><%= log.ip %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
