<% content_for :title, @pixel.name %>
<div class="page-head">
  <div>
    <h1><%= @pixel.name %></h1>
    <p class="muted small"><code><%= @pixel.public_id %></code> · <%= @pixel.status %></p>
  </div>
  <div class="pill-row">
    <%= link_to "Open demo funnel", demo_for_pixel_path(@pixel.public_id), class: "btn ghost small" %>
    <% if allowed_to?(:edit_pixel, @pixel) %>
      <%= link_to "Edit", edit_pixel_path(@pixel), class: "btn ghost small" %>
    <% end %>
  </div>
</div>

<div class="grid sidebar">
  <div>
    <div class="card">
      <h2>The snippet</h2>
      <p class="muted small">
        Paste this into the <code>&lt;head&gt;</code> of any allowed landing page.
        Generated by the app, with this pixel's id and this deployment's endpoint.
      </p>
      <pre><%= @snippet %></pre>
      <p class="small muted">
        The pixel id is public by design - it sits in the page source. It is not a
        credential: the origin allowlist below, plus a signed capture-session
        token issued by <code>/visit</code>, are what stop a third party posting
        leads into this account.
      </p>
    </div>

    <div class="card" style="margin-top:16px">
      <h2>Recent leads from this pixel</h2>
      <% if @recent_leads.any? %>
        <table>
          <tbody>
            <% @recent_leads.each do |lead| %>
              <tr>
                <td><%= link_to lead.full_name, lead_path(lead) %><div class="muted small"><%= lead.public_id %></div></td>
                <td class="small"><%= time_short lead.captured_at %></td>
                <td><%= run_status_badge lead.current_verification_run %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="empty">Nothing captured yet.</div>
      <% end %>
    </div>
  </div>

  <div>
    <div class="card tight">
      <h3>Allowed origins</h3>
      <% if @pixel.allowed_origins.any? %>
        <ul class="reasons">
          <% @pixel.allowed_origins.each do |origin| %>
            <li class="info"><span class="small"><%= origin %></span></li>
          <% end %>
        </ul>
      <% else %>
        <p class="small"><span class="badge b-fail">empty</span> An empty allowlist accepts nothing, not everything.</p>
      <% end %>
    </div>

    <div class="card tight" style="margin-top:16px">
      <h3>Layers this pixel runs</h3>
      <p class="small muted">Inherited from the account's subscription.</p>
      <div class="layers">
        <% DetectionModule.ordered.each do |mod| %>
          <% cost = @enabled_modules[mod.key] %>
          <div class="layer-row <%= "silent" if cost.nil? %>">
            <span class="lname"><%= mod.name %></span>
            <span class="ldetail small"><%= mod.question %></span>
            <span class="lcost"><%= cost ? "#{cost} cr" : "" %></span>
            <%= status_badge cost ? "pass" : "not_enabled" %>
          </div>
        <% end %>
      </div>
      <p class="small muted" style="margin-top:10px">
        Full stack cost: <%= @enabled_modules.values.sum %> credits per lead.
      </p>
    </div>

    <div class="card tight" style="margin-top:16px">
      <h3>Today</h3>
      <dl class="kv small">
        <dt>Capture sessions</dt><dd><%= @sessions_today %></dd>
      </dl>
    </div>
  </div>
</div>
